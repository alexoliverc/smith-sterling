generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApplicationStatusActor {
  SYSTEM
  OPERATOR
  APPLICANT
}

enum AdminRole {
  SUPER_ADMIN
  ANALYST
}

enum FormalizationStatus {
  PENDING
  BANK_DETAILS_SUBMITTED
  READY_FOR_DISBURSEMENT
  DISBURSED
  CANCELLED
}

enum CreditOfferStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CreditOfferActor {
  SYSTEM
  OPERATOR
  APPLICANT
}

model CreditApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(DRAFT)

  amount Int
  months Int

  publicProtocol  String?   @unique @db.VarChar(24)
  accessTokenHash String?   @db.Char(64)
  submittedAt     DateTime?

  applicantData ApplicantData?
  statusHistory ApplicationStatusHistory[]
  formalization CreditFormalization?
  offers        CreditOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantData {
  id String @id @default(cuid())

  applicationId String            @unique
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  nameEncrypted      String @db.Text
  cpfEncrypted       String @db.Text
  cpfLookupHash      String @db.Char(64)
  birthDateEncrypted String @db.Text

  emailEncrypted String @db.Text
  phoneEncrypted String @db.Text

  addressEncrypted String @db.Text

  employmentEncrypted String @db.Text
  incomeEncrypted     String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpfLookupHash])
}

model ApplicationStatusHistory {
  id String @id @default(cuid())

  applicationId String
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus
  toStatus   ApplicationStatus

  actorType ApplicationStatusActor @default(SYSTEM)
  actorId   String?                @db.VarChar(191)
  reason    String?                @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
}

model CreditFormalization {
  id String @id @default(cuid())

  applicationId String            @unique
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status FormalizationStatus @default(PENDING)

  bankDataEncrypted              String? @db.Text
  disbursementReferenceEncrypted String? @db.Text

  bankDataSubmittedAt DateTime?
  readyAt             DateTime?
  disbursedAt         DateTime?
  cancelledAt         DateTime?

  statusHistory FormalizationStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FormalizationStatusHistory {
  id String @id @default(cuid())

  formalizationId String
  formalization   CreditFormalization @relation(fields: [formalizationId], references: [id], onDelete: Cascade)

  fromStatus FormalizationStatus
  toStatus   FormalizationStatus

  actorType ApplicationStatusActor @default(SYSTEM)
  actorId   String?                @db.VarChar(191)
  reason    String?                @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([formalizationId, createdAt])
}

model AdminUser {
  id String @id @default(cuid())

  name         String    @db.VarChar(191)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.Text
  role         AdminRole @default(ANALYST)
  isActive     Boolean   @default(true)

  sessions AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id String @id @default(cuid())

  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.Char(64)

  expiresAt  DateTime
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ApplicationRecoveryRateLimitBucket {
  id String @id @default(cuid())

  keyHash     String   @db.Char(64)
  bucketStart DateTime
  attempts    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyHash, bucketStart])
  @@index([bucketStart])
}

model CreditOffer {
  id String @id @default(cuid())

  applicationId String
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  version Int

  status CreditOfferStatus @default(DRAFT)

  // Valores monetários são persistidos em centavos.
  principalCents       Int
  netDisbursementCents Int
  installmentCents     Int
  totalRepaymentCents  Int

  // Encargos destacados para composição e auditoria.
  iofCents       Int @default(0)
  otherFeesCents Int @default(0)

  months           Int
  installmentCount Int

  // Percentuais efetivos informados na proposta.
  monthlyRatePercent Decimal @db.Decimal(12, 8)
  annualRatePercent  Decimal @db.Decimal(12, 8)
  cetAnnualPercent   Decimal @db.Decimal(12, 8)

  firstDueDate DateTime
  expiresAt    DateTime

  termsVersion String @db.VarChar(50)

  presentedAt DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  statusHistory CreditOfferStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, version])
  @@index([applicationId, status])
  @@index([status, expiresAt])
}

model CreditOfferStatusHistory {
  id String @id @default(cuid())

  offerId String
  offer   CreditOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  fromStatus CreditOfferStatus
  toStatus   CreditOfferStatus

  actorType CreditOfferActor @default(SYSTEM)
  actorId   String?          @db.VarChar(191)

  reason String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
}
