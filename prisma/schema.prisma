generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApplicationStatusActor {
  SYSTEM
  OPERATOR
}

enum AdminRole {
  SUPER_ADMIN
  ANALYST
}

model CreditApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(DRAFT)

  amount Int
  months Int

  publicProtocol  String?   @unique @db.VarChar(24)
  accessTokenHash String?   @db.Char(64)
  submittedAt     DateTime?

  applicantData ApplicantData?
  statusHistory ApplicationStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantData {
  id String @id @default(cuid())

  applicationId String            @unique
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  nameEncrypted      String @db.Text
  cpfEncrypted       String @db.Text
  cpfLookupHash      String @db.Char(64)
  birthDateEncrypted String @db.Text

  emailEncrypted String @db.Text
  phoneEncrypted String @db.Text

  addressEncrypted String @db.Text

  employmentEncrypted String @db.Text
  incomeEncrypted     String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpfLookupHash])
}

model ApplicationStatusHistory {
  id String @id @default(cuid())

  applicationId String
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus
  toStatus   ApplicationStatus

  actorType ApplicationStatusActor @default(SYSTEM)
  actorId   String?                @db.VarChar(191)
  reason    String?                @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
}

model AdminUser {
  id String @id @default(cuid())

  name         String    @db.VarChar(191)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.Text
  role         AdminRole @default(ANALYST)
  isActive     Boolean   @default(true)

  sessions AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id String @id @default(cuid())

  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.Char(64)

  expiresAt  DateTime
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
