{
  "name": "smith-sterling",
  "version": "1.0.0",
  "description": "Plataforma digital da Smith Sterling.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "status:review": "node --conditions=react-server --import=tsx scripts/mark-under-review.ts",
    "admin:create": "node --conditions=react-server --import=tsx scripts/create-admin.ts",
    "admin:reset-password": "node --conditions=react-server --import=tsx scripts/reset-admin-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prestart": "node --conditions=react-server --import=tsx scripts/validate-runtime-env.ts",
    "prebuild": "prisma generate",
    "db:readiness": "node --conditions=react-server --import=tsx scripts/db-readiness.ts",
    "staging:preflight": "npm run prestart && prisma migrate status && npm run db:readiness",
    "production:readiness": "node --conditions=react-server --import=tsx scripts/production-readiness.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@next/env": "^16.3.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "hash-wasm": "4.12.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
